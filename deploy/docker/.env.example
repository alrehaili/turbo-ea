# Copy OUTSIDE the checkout, e.g. /secure/turbo-ea/.env.production; chmod 600.
# Blank required values intentionally fail docker compose config / deployment.
# Use the exact Git revision being built, not latest.
DEPLOY_TAG=
TURBO_EA_PUBLIC_URL=
# Non-sensitive host port used by the external reverse proxy; not a secret.
TURBO_EA_HOST_PORT=18920
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
SECRET_KEY=

# External DB overlay only: existing network and database container DNS alias.
POSTGRES_NETWORK=

# Exact ingress IP or narrow dedicated proxy CIDR; empty trusts no forwarding hops.
# Do not use 0.0.0.0/0 or broadly trust all Docker/private networks.
NGINX_TRUSTED_PROXIES=
TURBO_EA_EMBED_ALLOWED_ORIGINS=

DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
BACKEND_MEMORY_LIMIT=2G
FRONTEND_MEMORY_LIMIT=256M
GATEWAY_MEMORY_LIMIT=128M

# Preserve this fork's framework configuration; does not load sample inventory.
SEED_PROFILE=nora

# Optional mail configuration. Other supported controls are listed in README.md.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true
